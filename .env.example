# PRODUCTION treba uvijek imati MOCK_MODE=false (ili varijablu potpuno izostaviti).
# MOCK_MODE=true koristi se ISKLJUČIVO za lokalni development bez Google API ključa
# (generiše demo podatke, jasno označene "MOCK MODE" u UI-u).
MOCK_MODE=false

# Google Places API (New) ključ - OBAVEZAN kada je MOCK_MODE=false.
# Server-side varijabla - nikad se ne šalje u browser.
GOOGLE_MAPS_API_KEY=

# ====================================================================
# SLUŽBENI META WHATSAPP BUSINESS PLATFORM / CLOUD API
# ====================================================================
# Kako dobiti ove podatke:
# 1. Idi na https://developers.facebook.com/
# 2. Napravi aplikaciju tipa "Business"
# 3. Dodaj proizvod "WhatsApp"
# 4. U "API Setup" kopiraj Temporary/Permanent Access Token i Phone Number ID
# 5. U "Configuration" postavi Webhook URL i Verify Token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=local_lead_program_verify_token_2026

# ====================================================================
# OPCIONALNO: OPENAI API KLJUČ ZA JOŠ BOGATIJU AI ANALIZU
# (Ako nije postavljen, sistem automatski koristi ugrađeni pametni engine)
# ====================================================================
OPENAI_API_KEY=
